# =============================================================================================
# !!! IMPORTANT !!!
# Do not commit the real .env file.
# =============================================================================================

PORT=3002

# Vision/OCR provider key. Required: services/extraction.ts calls
# OpenAI's vision API to extract label fields from an uploaded image,
# /api/verify and /api/verify/batch fail without this set.
OPENAI_API_KEY=

# REQUIRED, not optional. No default is hardcoded in extraction.ts on
# purpose, model tier has real cost and latency consequences. As of
# this writing, GPT-5.6 ships as three explicit tiers with real
# price/speed differences: gpt-5.6-sol (flagship, slowest, $5/$30 per
# 1M tokens), gpt-5.6-terra (balanced, $2.50/$15), gpt-5.6-luna
# (fastest/cheapest, $1/$6). The bare "gpt-5.6" alias routes to Sol,
# confirm the actual model ID you want, don't rely on an alias.
# Verify current model names/pricing against OpenAI's docs before
# setting this, model lineups change.
OPENAI_VISION_MODEL=
