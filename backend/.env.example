# =============================================================================================
# !!! IMPORTANT !!!
# Do not commit the real .env file.
# =============================================================================================

PORT=3002

# Vision/OCR provider key. Required: services/extraction.ts calls
# OpenAI's vision API to extract label fields from an uploaded image,
# /api/verify and /api/verify/batch fail without this set.
OPENAI_API_KEY=

# Optional. Overrides the vision model services/extraction.ts calls,
# defaults to gpt-5.6 if unset. Model availability has been churning
# fast, confirm the default is still valid for your key before
# relying on it; set this explicitly if it isn't.
OPENAI_VISION_MODEL=
