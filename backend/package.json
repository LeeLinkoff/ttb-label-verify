{
  "name": "ttb-label-verify-backend",
  "version": "0.2.0",
  "description": "AI-powered alcohol label verification prototype for TTB. Backend with health check, Swagger docs, and label field extraction (OpenAI vision) + application-data matching implemented. Written in TypeScript, compiled to dist/ for production, run directly via tsx in dev.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "generate:schemas": "node -r ts-node/register scripts/generate-openapi-schemas.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts"
  },
  "keywords": [
    "ttb",
    "label-verification",
    "compliance",
    "ocr",
    "vision"
  ],
  "author": "Lee Linkoff",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "ts-node": "^10.9.2",
    "ts-json-schema-generator": "^2.9.0",
    "@types/node": "^22.9.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/swagger-ui-express": "^4.1.7"
  }
}

